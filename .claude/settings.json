{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*private-key*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.kube/config)",
      "Read(**/secrets/**)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Write(**/.git/**)",
      "Write(**/.env*)",
      "Write(**/*secret*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod -R 777 *)",
      "Bash(chown -R *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | sh*)",
      "Bash(* --force*)",
      "Bash(git push --force*)",
      "Bash(Remove-Item * -Recurse*)",
      "Bash(del /s /q*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(bun publish*)"
    ],
    "ask": [
      "Write(**/.mcp.json)",
      "Write(**/managed-settings.json)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git cherry-pick*)",
      "Bash(git reset*)",
      "Bash(*deploy*)",
      "Bash(*migration*)",
      "Bash(*migrate*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm add*)",
      "Bash(pnpm install*)",
      "Bash(pnpm add*)",
      "Bash(yarn install*)",
      "Bash(yarn add*)",
      "Bash(bun install*)",
      "Bash(bun add*)",
      "Bash(uv add*)",
      "Bash(uv sync*)",
      "Bash(pip install*)",
      "Bash(poetry add*)",
      "Bash(cargo add*)",
      "Bash(go get*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(kubectl *)",
      "Bash(terraform apply*)",
      "Bash(gh pr merge*)"
    ],
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Glob(**)",
      "Bash(git status*)",
      "Bash(git branch*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(node .claude/hooks/validators/control-plane-check.js*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(npm run build*)",
      "Bash(ruff check*)",
      "Bash(pytest*)",
      "Bash(uv run pytest*)",
      "Bash(cargo test*)",
      "Bash(cargo clippy*)",
      "Bash(cargo build*)",
      "Bash(go build*)",
      "Bash(go test*)"
    ]
  },
  "claudeMdExcludes": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/target/**",
    "**/.git/**"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow/session-start.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validators/analyze-command.js\""
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validators/web-access-guard.js\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validators/web-access-guard.js\""
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validators/protect-files.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow/format-touched-file.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow/stop-summary.js\""
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow/stop-summary.js\""
          }
        ]
      }
    ]
  }
}
